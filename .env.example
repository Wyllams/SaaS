# Shared
APP_ENV=development
LOG_LEVEL=info

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# API
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Worker / queue
REDIS_URL=redis://HOST:PORT

# Observability
SENTRY_DSN=
# Explicitly configure per environment. Do not assume a Production sample rate.
SENTRY_TRACES_SAMPLE_RATE=
