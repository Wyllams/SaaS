{
  "name": "@crewcommand/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "node ../../scripts/package-task.mjs build",
    "check": "tsc --noEmit && node --experimental-strip-types --test tests/*.test.mjs",
    "poc:bundle:android": "expo export --platform android --output-dir .poc/android-bundle",
    "poc:bundle:ios": "expo export --platform ios --output-dir .poc/ios-bundle"
  },
  "dependencies": {
    "@crewcommand/api-client": "workspace:*",
    "@crewcommand/design-tokens": "workspace:*",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.5",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
